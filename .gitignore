# ============================================================================
# .gitignore — cinematic-scroll-skill
#
# This repo IS the source: assets/, examples/, templates/ are committed on
# purpose. We only ignore generated output, installed deps, secrets, and junk.
# (Do NOT ignore those source dirs.)
# ============================================================================

# ----------------------------------------------------------------------------
# macOS
# ----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
Icon?

# ----------------------------------------------------------------------------
# Windows / other OS junk
# ----------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ----------------------------------------------------------------------------
# Node / package managers (templates are source — consumers install their own)
# ----------------------------------------------------------------------------
node_modules/
jspm_packages/
.npm
.yarn/
.yarn-integrity
.pnp
.pnp.js
.pnp.cjs
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn-*.log
pnpm-debug.log*
lerna-debug.log*
.node_repl_history
*.tgz

# ----------------------------------------------------------------------------
# Next.js / build output (if anyone runs the template in place)
# ----------------------------------------------------------------------------
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts
.swc/

# Token build outputs ARE committed — Mode A is zero-build and inlines the
# generated CSS, so tokens/build/ must override the generic build/ rule above.
!tokens/build/
!tokens/build/**

# ----------------------------------------------------------------------------
# Environment / secrets — NEVER commit fal.ai keys (FAL_KEY)
# Used by examples/studio/generate.mjs via examples/studio/.env.local
# or the repo-root .env.local. Keep *.example templates tracked.
# ----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
secrets.json
!.env.example
!.env*.example

# ----------------------------------------------------------------------------
# Vercel
# ----------------------------------------------------------------------------
.vercel
.vercel/

# ----------------------------------------------------------------------------
# Generated AI assets (regenerable via generate.mjs, can be large)
# Stills committed under examples/studio/assets/ are kept on purpose.
# ----------------------------------------------------------------------------
templates/nextjs/public/generated/

# ----------------------------------------------------------------------------
# Logs / coverage / cache
# ----------------------------------------------------------------------------
*.log
logs/
coverage/
.nyc_output/
*.lcov
.cache/
.eslintcache
.stylelintcache
.parcel-cache/

# ----------------------------------------------------------------------------
# Editors / IDE
# ----------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ----------------------------------------------------------------------------
# Misc temp
# ----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
.history/

# transient launch/preview artifacts
assets/_frame_*.jpg
video/install.log
video/node_modules/
video/out/
# HyperFrames preview caches (any film project)
.thumbnails/

# cinematic-doctor generated report (re-created on every run)
tools/cinematic-doctor/cinematic-report.json

# Reel: 4K master is local-only (too heavy for git); share the 1080p.
assets/reel.mp4
# Raw capture working dir — canonical render input is video/public/footage/.
video/footage/

# Generated render outputs — regenerate via `npm run render:*` (source is video/src/).
# Kept out of git history; the README/site use GIF previews + the live demo, not these.
assets/doctor.mp4
assets/flagship-3d.mp4
video/*/renders/

# page-proof tool output (screenshots + report) — recreated on every run.
.page-proof/

# Social/LinkedIn post captures + posters — local deliverables, regenerate from examples.
assets/post2-*
assets/doctor-thumb*
