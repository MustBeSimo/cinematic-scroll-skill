{
  "name": "cinematic-scroll-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project that renders the Cinematic Scroll promo video (prompt → site → worlds → end card).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:reel": "remotion render src/index.ts Reel ../assets/reel.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --scale=2",
    "render:reel:1080": "remotion render src/index.ts Reel ../assets/reel-1080.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:reel2": "remotion render src/index.ts Reel2 ../assets/reel2.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:reel3": "remotion render src/index.ts Reel3 ../assets/reel3.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:reel3:4k": "remotion render src/index.ts Reel3 ../assets/reel3-4k.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --scale=2",
    "poster:reel3": "remotion still src/index.ts Reel3 ../assets/reel3-poster.jpg --frame=660 --scale=2",
    "render:reel3:vertical": "remotion render src/index.ts Reel3Vertical ../assets/reel3-vertical.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster:reel3:vertical": "remotion still src/index.ts Reel3Vertical ../assets/reel3-vertical-poster.jpg --frame=620",
    "poster:reel2": "remotion still src/index.ts Reel2 ../assets/reel2-poster.jpg --frame=480 --scale=2",
    "render:reel:webm": "remotion render src/index.ts Reel ../assets/reel.webm --codec=vp9 --scale=1.5",
    "poster:reel": "remotion still src/index.ts Reel ../assets/reel-poster.jpg --frame=620 --scale=2",
    "render:vertical": "remotion render src/index.ts ReelVertical ../assets/reel-vertical.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster:vertical": "remotion still src/index.ts ReelVertical ../assets/reel-vertical-poster.jpg --frame=170",
    "render": "remotion render src/index.ts Promo ../assets/demo-loop.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --scale=2",
    "render:1080": "remotion render src/index.ts Promo ../assets/demo-loop-1080.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:webm": "remotion render src/index.ts Promo ../assets/demo-loop.webm --codec=vp9 --scale=1.5",
    "poster": "remotion still src/index.ts Promo ../assets/demo-poster.jpg --frame=430 --scale=2",
    "gif": "remotion render src/index.ts Promo ../assets/demo-loop.gif --codec=gif --every-nth-frame=2 --scale=0.6",
    "build:all": "npm run render && npm run render:webm && npm run poster",
    "typecheck": "tsc --noEmit",
    "render:flagship": "remotion render src/index.ts Flagship3D ../assets/flagship-3d.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --scale=2",
    "render:flagship:1080": "remotion render src/index.ts Flagship3D ../assets/flagship-3d-1080.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster:flagship": "remotion still src/index.ts Flagship3D ../assets/flagship-3d-poster.jpg --frame=700 --scale=2",
    "render:doctor": "remotion render src/index.ts Doctor ../assets/doctor.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --scale=2",
    "render:doctor:1080": "remotion render src/index.ts Doctor ../assets/doctor-1080.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster:doctor": "remotion still src/index.ts Doctor ../assets/doctor-poster.jpg --frame=330 --scale=2",
    "render:showcase": "remotion render src/index.ts SkillShowcase ../assets/skill-showcase.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:showcase:4k": "remotion render src/index.ts SkillShowcase ../assets/skill-showcase-4k.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --scale=2",
    "poster:showcase": "remotion still src/index.ts SkillShowcase ../assets/skill-showcase-poster.jpg --frame=150",
    "render:showcase:vertical": "remotion render src/index.ts SkillShowcaseVertical ../assets/skill-showcase-vertical.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "poster:showcase:vertical": "remotion still src/index.ts SkillShowcaseVertical ../assets/skill-showcase-vertical-poster.jpg --frame=150",
    "heygen:presenter": "node scripts/heygen-presenter.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.481",
    "@remotion/google-fonts": "^4.0.0",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
